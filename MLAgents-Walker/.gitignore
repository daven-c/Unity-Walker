# This file is used to ignore files in git commits
# For a Unity project

# Logs
/[Ll]ogs/
/[Ll]og.txt

# Memory Crashes
/[Mm]emoryCaptures/

# Asset meta files
*.pidb
*.pidb.meta

# Files built by Visual Studio
.vs/
.vscode/

# Autogenerated files
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ibrary/

# Local user-specific files
.DS_Store
*.swp
*.swo
*~

# IDE specific files
.idea/
*.sublime-workspace

# Rider
.idea/
*.sln.iml

# JetBrains Rider
.idea/
*.sln.iml

# Gradle cache directory
.gradle

# OS X folder attributes
.DS_Store

# Ignore yarn error log
yarn-error.log

# Python cache
__pycache__/
*.py[cod]
*$py.class

# pip
*.egg-info/
dist/
build/

# User settings
ProjectSettings/ProjectSettings.asset